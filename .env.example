# PostgreSQL
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering
POSTGRES_PORT=5432

# LocalStack (SQS)
AWS_REGION=us-east-1
LOCALSTACK_PORT=4566

# App
APP_PORT=3000

# App config (validated at boot, see src/infrastructure/config/app-config.ts)
DATABASE_URL=postgres://wagering:wagering@postgres:5432/wagering
SQS_ENDPOINT=http://localstack:4566
SQS_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events

# Optional tuning (defaults shown)
OUTBOX_PUBLISH_INTERVAL_MS=1000
PENDING_REFERENCE_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
PENDING_REFERENCE_BATCH_SIZE=50
SQS_MAX_MESSAGES=10
